{
  "$defs": {
    "identifier": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "type": "string"
    }
  },
  "$id": "https://liapoldus.github.io/spec/runtime/v1/settings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "entities": {
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "export": {
            "$ref": "#/$defs/identifier"
          },
          "name": {
            "$ref": "#/$defs/identifier"
          },
          "tenantSites": {
            "items": {
              "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "export",
          "tenantSites",
          "entities"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "groupId": {
      "$ref": "#/$defs/identifier"
    },
    "modelInstanceId": {
      "$ref": "#/$defs/identifier"
    },
    "module": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "1"
    }
  },
  "required": [
    "schemaVersion",
    "groupId",
    "modelInstanceId",
    "module",
    "commands"
  ],
  "title": "Runtime v1 settings",
  "type": "object"
}
